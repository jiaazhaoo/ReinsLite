[Unit]
Description=reins board (C14): running and developing
After=network.target

[Service]
ExecStart=@REINS_DIR@/bin/reins board serve
Restart=always
# backstop only: every request closes its registry connection (2026-10-14: 1024 fds ran out)
LimitNOFILE=65536
RestartSec=5

[Install]
WantedBy=default.target
