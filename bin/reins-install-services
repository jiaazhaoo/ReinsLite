#!/usr/bin/env bash
# Install the gateway / watchdog / board as systemd --user services for this checkout.
# Where the registry lives comes from ~/.config/reins/settings.toml (home = ...) or REINS_HOME.
set -euo pipefail
here="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
dest="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
mkdir -p "$dest"
for f in "$here"/systemd/reins-*.service "$here"/systemd/reins-*.timer; do
  # the services run with the python3 found now (e.g. a conda env with openpyxl), not the system one
  sed -e "s#@REINS_DIR@#$here#g" -e "s#@PATH@#$(dirname "$(command -v python3)"):/usr/local/bin:/usr/bin:/bin#g" "$f" > "$dest/$(basename "$f")"
  echo "installed $(basename "$f")"
done
systemctl --user daemon-reload
systemctl --user enable --now reins-gateway reins-watchdog reins-board reins-report.timer
echo "board: http://127.0.0.1:8791   (keep services running after logout: loginctl enable-linger $USER)"
